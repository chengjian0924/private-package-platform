{
  "name": "yuanjian",
  "version": "1.0.0",
  "private": true,
  "description": "源鉴 · 内网依赖安全治理平台 MVP：npm registry + PyPI index + 批量导入/缺失补包 + 六维安全校验 + 本地账号认证",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env.development dist/main.js",
    "start:dev": "npm run build && npm run start",
    "start:test": "npm run build && node --env-file=.env.test dist/main.js",
    "test": "jest --runInBand --forceExit",
    "test:system": "npm run build && node test/system/system-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vulndb:sync": "node scripts/osv-sync.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "adm-zip": "^0.5.16",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "semver": "^7.6.3",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
