# 源鉴容器化生产配置模板
# 用法：cp deploy/.env.production.example deploy/.env.production，chmod 600，只改【必改 5 项】后即可 docker compose up -d
# 注意：本文件由 compose 的 env_file 注入容器，三个角色共用；角色差异由 compose 的 environment 覆盖。
#
# 【必改 5 项】下面 ★ 标注的 3 个对外基址 + 2 个初始口令
# 【无需修改】其余已按生产默认值预置，直接 up -d 即可运行；
#             备份目录与 cron 属上线后可选运维，不配置不影响启动（见部署手册第 6 节）。

NODE_ENV=production

# ---- ★ 必改 3 项：对外基址（HTTP 直连形态）----
# 客户端从其他机器访问，必须写内网可达的地址，不要写 127.0.0.1（那是容器回环）
PUBLIC_BASE_URL=http://yuanjian.example.internal:8860
NPM_BASE_URL=http://yuanjian.example.internal:8861
PYPI_BASE_URL=http://yuanjian.example.internal:8862
# 生产护栏默认要求 https；直连形态必须显式豁免，启动日志会打印明文风险告警
ALLOW_INSECURE_BASE_URL=true

# ---- 数据目录（容器内绝对路径，对应 compose 的 named volume）----
DATA_DIR=/var/lib/yuanjian/data
QUARANTINE_DIR=/var/lib/yuanjian/quarantine

# ---- ★ 必改 2 项：初始管理员（建号后必须从本文件移除 INITIAL_PASSWORD_ADMIN 并重建容器）----
# 生效变量只有 INITIAL_PASSWORD_ADMIN / INITIAL_PASSWORD_USER / BOOTSTRAP_ADMIN_USERNAME
BOOTSTRAP_ADMIN_USERNAME=admin
INITIAL_PASSWORD_ADMIN=<一次性强口令，至少8位且不含用户名>
INITIAL_PASSWORD_USER=<新建普通账号的初始口令>

# ---- 安全与观测（已预置，无需修改）----
# /metrics 抓取令牌：部署前必须生成，禁止留空（留空会让 /metrics 变成匿名可读）。
# 生成方式（复制本样例为 deploy/.env.production 后执行）：
#   sed -i "s|^METRICS_TOKEN=.*|METRICS_TOKEN=$(openssl rand -hex 32)|" deploy/.env.production
METRICS_TOKEN=<部署前用 openssl rand -hex 32 生成并替换>
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOG_LEVEL=info
LOG_FORMAT=json
# 容器内关闭文件日志，由 docker logs 采集 stdout
LOG_FILE_ENABLED=false

# ---- 业务参数（可按内网规模调整，均可在控制台「字典管理」运行时覆盖）----
BATCH_DEFAULT_MODE=partial
# 目标运行时必须是具体版本号（校验用 semver.satisfies(目标, 包的 engines 范围)）
# 写成范围表达式如 ">=18" 会导致所有声明 engines 的 npm 包被误判为不兼容而无法入库
DEFAULT_NODE_TARGET=22.23.5
DEFAULT_PYTHON_TARGET=3.11.9
MAX_ITEMS=5000
MAX_UPLOAD_BYTES=209715200
# npm / PyPI 上传包大小上限（字节）：默认 200MB，可在控制台「字典管理 → 上传包大小上限」运行时调整
MAX_NPM_UPLOAD_BYTES=209715200
MAX_PYPI_UPLOAD_BYTES=209715200
# HTTP body 硬天花板（字节）：必须 ≥ 业务上限 × 1.34（base64 膨胀），改动需重启；网关 client_max_body_size 同步
MAX_NPM_PUBLISH_BYTES=301989888
MAX_PYPI_PUBLISH_BYTES=301989888
# 单文件扫描上限：需 ≥ 上传硬天花板，否则大包会被 INT-010 判 critical 拦截
SECURITY_MAX_SCAN_FILE_BYTES=301989888
DELETED_PACKAGE_RETENTION_DAYS=30
SECURITY_SCAN_RETENTION_DAYS=180
# 磁盘水位（DATA_DIR 所在分区）：已用百分比告警/只读阈值 + 最小剩余空间下限。
# 三者任一命中即生效：告警仅记录，只读会让所有写接口返回 507。
# 约束：0 < 告警 < 只读 ≤ 100；当前设为 99% 告警、100% 只读、剩余低于 256MB 只读。
DISK_ALERT_PERCENT=99
DISK_READONLY_PERCENT=100
DISK_MIN_FREE_BYTES=268435456
RATE_LIMIT_ENABLED=true

# ---- 时钟观测（可选）----
# NTP_SERVER=ntp.example.internal
